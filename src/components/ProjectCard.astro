---
interface Props {
  title: string;
  description: string;
  tools: string[];
  href: string;
  ctaLabel: string;
  toolsLabel: string;
  index: number;
}

const { title, description, tools, href, ctaLabel, toolsLabel, index } = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-ink/5 bg-paper shadow-sm shadow-ink/5 transition-shadow hover:shadow-lg hover:shadow-ink/10">
  <div class="flex items-center justify-between border-b border-ink/5 bg-paper-soft/70 px-6 py-4">
    <span class="font-display text-2xl font-extrabold text-ink/10">0{index}</span>
    <span class="rounded-full bg-accent-soft px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-accent-strong">
      Case study
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-4 p-6">
    <h3 class="font-display text-lg font-bold leading-snug text-ink">{title}</h3>
    <p class="text-sm leading-relaxed text-ink-soft">{description}</p>

    <div class="pt-2">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-ink-soft/70">{toolsLabel}</p>
      <div class="flex flex-wrap gap-1.5">
        {
          tools.map((tool) => (
            <span class="rounded-full border border-ink/10 px-2.5 py-1 text-xs font-medium text-ink-soft">
              {tool}
            </span>
          ))
        }
      </div>
    </div>

    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent-strong transition-colors group-hover:text-accent"
    >
      {ctaLabel}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>

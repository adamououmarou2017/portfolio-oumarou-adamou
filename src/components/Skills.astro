---
import { useTranslations, items } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  {
    title: t('skills.cat1'),
    items: items(t, 'skills.cat1_items'),
    icon: 'M9 17v-6h6v6m-9 4h12a2 2 0 002-2V7l-5-5H5a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: t('skills.cat2'),
    items: items(t, 'skills.cat2_items'),
    icon: 'M9 7h6m-6 4h6m-6 4h4M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: t('skills.cat3'),
    items: items(t, 'skills.cat3_items'),
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    title: t('skills.cat4'),
    items: items(t, 'skills.cat4_items'),
    icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.5 7h.01',
  },
];
---

<section id="skills" class="bg-paper-soft/60 py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wide text-accent">{t('skills.kicker')}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">
        {t('skills.title')}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">{t('skills.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((cat) => (
          <div class="rounded-2xl border border-ink/5 bg-paper p-6 shadow-sm shadow-ink/5">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-accent-soft text-accent-strong">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
              </svg>
            </div>
            <h3 class="mt-4 font-display text-base font-bold text-ink">{cat.title}</h3>
            <ul class="mt-3 space-y-2">
              {cat.items.map((item) => (
                <li class="flex gap-2 text-sm leading-snug text-ink-soft">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
